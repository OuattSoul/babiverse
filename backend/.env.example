# Copier vers backend/.env puis adapter. Sans ce fichier, DEBUG est désactivé (réglage de production).
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-en-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Sans DATABASE_URL, SQLite (backend/db.sqlite3) est utilisé pour le prototype local.
# PostgreSQL recommandé dès la bêta (verrous de ligne réels, concurrence testée). Base managée : ajouter ?sslmode=require.
# DATABASE_URL=postgres://babiverse:babiverse@localhost:5432/babiverse
# Durée de réutilisation des connexions en secondes (0 derrière PgBouncer en mode transaction).
# DB_CONN_MAX_AGE=60
# Redis : compteurs de limitation de débit partagés entre les workers gunicorn (obligatoire avec plusieurs workers).
# REDIS_URL=redis://localhost:6379/0
# Adresse publique du jeu, utilisée dans les liens envoyés par e-mail (confirmation, mot de passe oublié).
PUBLIC_URL=http://localhost:5173
# Envoi des e-mails par Resend (https://resend.com/api-keys). Sans clé et avec DJANGO_DEBUG=1, les e-mails
# s'affichent dans la console du backend. Obligatoire en production.
# RESEND_API_KEY=re_xxxxxxxxx
# Expéditeur : un domaine vérifié dans Resend (onboarding@resend.dev ne livre qu'à l'adresse du compte Resend).
# DEFAULT_FROM_EMAIL=BabiVerse <no-reply@exemple.com>
# Atelier d'assets : adresse et clé partagée (BABIVERSE_GAME_KEY de l'atelier). En DEBUG : http://127.0.0.1:8000 et
# babiverse-dev par défaut. En production, préférer `python manage.py sync_atelier` (fichier shared/atelier/game-pack.json).
# ATELIER_URL=http://127.0.0.1:8000
# ATELIER_KEY=babiverse-dev
# Appels vocaux entre joueurs (WebRTC) : serveurs ICE en JSON. Défaut : STUN public de Google ; « [] » = même réseau seulement.
# WEBRTC_ICE_SERVERS=[{"urls": "stun:stun.l.google.com:19302"}]
